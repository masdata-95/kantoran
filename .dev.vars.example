# Template untuk .dev.vars (dipakai `npm run preview` — workerd lokal).
# Copy jadi .dev.vars lalu isi nilai aslinya. .dev.vars sudah di-gitignore.
# Isinya sama dengan secret server di .env.local.

GEMINI_API_KEY_1=
# GEMINI_API_KEY_2..5 opsional

# Groq lama sudah mati — isi hanya kalau ada key baru
# GROQ_API_KEY_1=

OPENROUTER_API_KEY=

# Login Google (Google Cloud Console -> Credentials -> OAuth client, tipe Web).
# Redirect URI yang didaftarkan: https://kantoran.id/api/auth/callback
# (dan http://localhost:3000/api/auth/callback untuk dev).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Kunci tanda tangan link video; HARUS sama dengan secret KUNCI_VIDEO di Worker masdata-video.
KUNCI_VIDEO=

# Email founder (dipisah koma) yang boleh membuka /admin. Kosong = semua ditolak.
ADMIN_EMAILS=

# Opsional: override model tanpa deploy ulang (default gemini-3.5-flash di lib/ai.ts)
# GEMINI_MODEL=
# Opsional: ambang lulus review task (default 70)
# KANTORAN_PASS_SCORE=
